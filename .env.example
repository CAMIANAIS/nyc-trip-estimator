# ==========================================
# FASTAPI BACKEND CONFIGURATION
# ==========================================

# FastAPI backend base URL
# Local: http://localhost:8000
# Production: https://your-backend-url.com (Railway, Render, Fly.io, etc.)
VITE_API_URL=http://localhost:8000

# Mock mode
# true  = Use mock data when API is unreachable (good for demos/testing)
# false = Use real API (requires backend to be running at VITE_API_URL)
VITE_USE_MOCK=false

# ==========================================
# OPTIONAL: MAP TILE LAYER
# ==========================================
# Optional light basemap, e.g. CARTO Positron with your key
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png?api_key=YOUR_KEY
