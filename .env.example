# FastAPI backend base URL
VITE_API_URL=http://localhost:8000
# Use mock predictions when the API is unreachable (true/false)
VITE_USE_MOCK=true
# Optional light basemap, e.g. CARTO Positron with your key
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png?api_key=YOUR_KEY
